# Copy to .env.local for local development
# Supabase (Phase I: optional placeholders are fine)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — server-side only (Vercel environment variable, NOT prefixed with VITE_)
# Set this in Vercel Dashboard → Project → Settings → Environment Variables
# NEVER put this in .env.local if you commit to version control
ANTHROPIC_API_KEY=sk-ant-...
